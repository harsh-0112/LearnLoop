# Anthropic API key used by the AI tutoring / generation services
ANTHROPIC_API_KEY=

# Defaults to backend/learnloop.db; swap for e.g. postgresql+psycopg://user:pass@db:5432/learnloop
# DATABASE_URL=sqlite:///./learnloop.db

# Embedding model used for document chunk vectors
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# Frontend -> backend base URL
NEXT_PUBLIC_API_URL=http://localhost:8000
